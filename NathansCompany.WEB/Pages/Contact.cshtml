@page
@{
    ViewData["Title"] = "Contact";
}

<section class="contact-page">
    <div class="site-shell">
        <p class="contact-kicker">CONTACT US</p>
        <div class="contact-heading">
            <div>
                <h1>Let's talk about your project.</h1>
                <p>Whether you are planning a home, outbuilding, remodel, or property improvement, we would be glad to hear what you have in mind.</p>
            </div>
            <p class="contact-note">Get in touch by phone or email and we will get back to you as soon as we can.</p>
        </div>

        <div class="contact-details" aria-label="Contact information">
            <a class="contact-card" href="tel:+19202686855">
                <span class="contact-card-label">CALL OR TEXT</span>
                <strong>(920) 268-6855</strong>
                <span class="contact-card-action">Call or text us <span aria-hidden="true">&rarr;</span></span>
            </a>
            <a class="contact-card" href="mailto:BellresidentialLLC@gmail.com">
                <span class="contact-card-label">EMAIL</span>
                <strong>BellresidentialLLC@gmail.com</strong>
                <span class="contact-card-action">Send an email <span aria-hidden="true">&rarr;</span></span>
            </a>
            <a class="contact-card" href="https://www.facebook.com/people/Bell-Residential-LLC/100091550928434/" target="_blank" rel="noopener noreferrer">
                <span class="contact-card-label">FACEBOOK</span>
                <strong>Bell Residential LLC</strong>
                <span class="contact-card-action">Follow us on Facebook <span aria-hidden="true">&nearr;</span></span>
            </a>
        </div>
    </div>
</section>
