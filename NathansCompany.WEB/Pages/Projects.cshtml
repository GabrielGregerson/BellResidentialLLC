@page
@{
    ViewData["Title"] = "Projects";
}

<section class="projects-hero"><div class="site-shell"><p class="projects-kicker">OUR WORK</p><h1>Built for the way you live.</h1><p>Explore a selection of garages, remodels, outdoor spaces, and other projects completed by Bell Residential LLC.</p></div></section>

<section class="projects-list"><div class="site-shell">
    <article class="project-category"><header class="project-category-heading"><div><p class="projects-kicker">OUTBUILDINGS</p><h2>Garages</h2></div><p>Practical, durable garages with room for vehicles, storage, and projects.</p></header><div class="project-photo-grid" aria-label="Garage project photos">
        <button class="project-photo project-photo-wide" type="button" aria-label="View garage project photo 1"><img src="~/images/Garage1.jpg" asp-append-version="true" alt="Completed garage project" /><span>GARAGE</span></button>
        <button class="project-photo" type="button" aria-label="View garage project photo 2"><img src="~/images/Garage2.jpg" asp-append-version="true" alt="Completed garage project" /><span>GARAGE</span></button>
        <button class="project-photo" type="button" aria-label="View garage project photo 3"><img src="~/images/Garage3.jpg" asp-append-version="true" alt="Completed garage project" /><span>GARAGE</span></button>
    </div></article>
    <article class="project-category"><header class="project-category-heading"><div><p class="projects-kicker">INTERIOR RENOVATIONS</p><h2>Kitchens</h2></div><p>Functional, refreshed kitchen spaces designed for daily living and gathering.</p></header><div class="project-photo-grid" aria-label="Kitchen project photos">
        <button class="project-photo project-photo-wide" type="button" aria-label="View kitchen project photo 1"><img src="~/images/Kitchen1.jpg" asp-append-version="true" alt="Completed kitchen remodel" /><span>KITCHEN</span></button>
        <button class="project-photo" type="button" aria-label="View kitchen project photo 2"><img src="~/images/Kitchen2.jpg" asp-append-version="true" alt="Completed kitchen remodel" /><span>KITCHEN</span></button>
        <button class="project-photo" type="button" aria-label="View kitchen project photo 3"><img src="~/images/Kitchen3.jpg" asp-append-version="true" alt="Completed kitchen remodel" /><span>KITCHEN</span></button>
    </div></article>
    <article class="project-category"><header class="project-category-heading"><div><p class="projects-kicker">PROPERTY IMPROVEMENTS</p><h2>Landscaping</h2></div><p>Outdoor improvements that add definition, function, and curb appeal to your property.</p></header><div class="project-photo-grid" aria-label="Landscaping project photos">
        <button class="project-photo project-photo-wide" type="button" aria-label="View landscaping project photo 1"><img src="~/images/LandScaping1.jpg" asp-append-version="true" alt="Completed landscaping project" /><span>LANDSCAPING</span></button>
        <button class="project-photo project-photo-wide" type="button" aria-label="View landscaping project photo 2"><img src="~/images/LandScaping2.jpg" asp-append-version="true" alt="Completed landscaping project" /><span>LANDSCAPING</span></button>
    </div></article>
    <article class="project-category"><header class="project-category-heading"><div><p class="projects-kicker">OUTBUILDINGS</p><h2>Large Buildings</h2></div><p>Flexible, spacious buildings built for work, storage, equipment, and custom uses.</p></header><div class="project-photo-grid" aria-label="Large building project photos">
        <button class="project-photo project-photo-wide" type="button" aria-label="View large building project photo"><img src="~/images/LargeBuilding1.jpg" asp-append-version="true" alt="Completed large building project" /><span>LARGE BUILDING</span></button>
    </div></article>
    <article class="project-category"><header class="project-category-heading"><div><p class="projects-kicker">OUTDOOR LIVING</p><h2>Patios</h2></div><p>Outdoor spaces made for relaxing, gathering, and enjoying more time at home.</p></header><div class="project-photo-grid" aria-label="Patio project photos">
        <button class="project-photo project-photo-wide" type="button" aria-label="View patio project photo 1"><img src="~/images/Patio1.jpg" asp-append-version="true" alt="Completed patio project" /><span>PATIO</span></button>
        <button class="project-photo" type="button" aria-label="View patio project photo 2"><img src="~/images/Patio2.jpg" asp-append-version="true" alt="Completed patio project" /><span>PATIO</span></button>
        <button class="project-photo" type="button" aria-label="View patio project photo 3"><img src="~/images/Patio3.jpg" asp-append-version="true" alt="Completed patio project" /><span>PATIO</span></button>
        <button class="project-photo" type="button" aria-label="View patio project photo 4"><img src="~/images/Patio4.jpg" asp-append-version="true" alt="Completed patio project" /><span>PATIO</span></button>
        <button class="project-photo project-photo-wide" type="button" aria-label="View patio project photo 5"><img src="~/images/Patio5.jpg" asp-append-version="true" alt="Completed patio project" /><span>PATIO</span></button>
    </div></article>
    <article class="project-category"><header class="project-category-heading"><div><p class="projects-kicker">INTERIOR RENOVATIONS</p><h2>Remodels</h2></div><p>Thoughtful renovations that update a home while bringing more value and comfort to everyday spaces.</p></header><div class="project-photo-grid" aria-label="Remodel project photos">
        <button class="project-photo project-photo-wide" type="button" aria-label="View remodel project photo"><img src="~/images/Remodel1.jpg" asp-append-version="true" alt="Completed home remodel" /><span>REMODEL</span></button>
    </div></article>
    <article class="project-category"><header class="project-category-heading"><div><p class="projects-kicker">INTERIOR RENOVATIONS</p><h2>Showers</h2></div><p>Clean, comfortable shower updates with attention to every detail.</p></header><div class="project-photo-grid" aria-label="Shower project photos">
        <button class="project-photo project-photo-wide" type="button" aria-label="View shower project photo 1"><img src="~/images/Shower1.jpg" asp-append-version="true" alt="Completed shower remodel" /><span>SHOWER</span></button>
        <button class="project-photo" type="button" aria-label="View shower project photo 2"><img src="~/images/Shower2.jpg" asp-append-version="true" alt="Completed shower remodel" /><span>SHOWER</span></button>
        <button class="project-photo" type="button" aria-label="View shower project photo 3"><img src="~/images/Shower3.jpg" asp-append-version="true" alt="Completed shower remodel" /><span>SHOWER</span></button>
        <button class="project-photo" type="button" aria-label="View shower project photo 4"><img src="~/images/Shower4.jpg" asp-append-version="true" alt="Completed shower remodel" /><span>SHOWER</span></button>
        <button class="project-photo project-photo-wide" type="button" aria-label="View shower project photo 5"><img src="~/images/Shower5.jpg" asp-append-version="true" alt="Completed shower remodel" /><span>SHOWER</span></button>
    </div></article>
</div></section>

<div class="project-lightbox" id="project-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Expanded project image"><button class="project-lightbox-close" type="button" aria-label="Close expanded image">×</button><div class="project-lightbox-image"><img alt="" /><span></span></div></div>
