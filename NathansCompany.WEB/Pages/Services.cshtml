@page
@{
    ViewData["Title"] = "Services";
}

<section class="services-hero">
    <div class="site-shell">
        <p class="services-kicker">WHAT WE BUILD</p>
        <h1>Built around your property, your plans, and the way you live.</h1>
        <p>From a new home to the finishing work around it, we bring practical experience, careful craftsmanship, and clear communication to every project.</p>
    </div>
</section>

<section class="services-list">
    <div class="site-shell">
        <div class="services-list-heading">
            <div>
                <p class="services-kicker">OUR SERVICES</p>
                <h2>Space to live, work, and enjoy.</h2>
            </div>
            <p>We take on a range of residential, outbuilding, and property-improvement projects. Tell us what you have in mind.</p>
        </div>

        <div class="services-grid">

            <article class="service-card service-card-homes">
                <div class="service-card-content">
                    <h3>New Homes</h3>
                    <p>From the first plans to the final details, we build comfortable, lasting homes designed around the people who live in them.</p>
                </div>
            </article>

            <article class="service-card service-card-barndominiums">
                <div class="service-card-content">
                    <h3>Barndominiums</h3>
                    <p>Bring living, working, and storage together in one versatile space built around the way you use your property.</p>
                </div>
            </article>

            <article class="service-card service-card-garages">
                <div class="service-card-content">
                    <h3>Garages</h3>
                    <p>More than a place to park. We build durable garages with room for vehicles, equipment, storage, hobbies, and everyday projects.</p>
                </div>
            </article>

            <article class="service-card service-card-pole-barns">
                <div class="service-card-content">
                    <h3>Pole Barns</h3>
                    <p>Dependable buildings designed for equipment, storage, agricultural needs, and the demands of your property.</p>
                </div>
            </article>

            <article class="service-card service-card-additions">
                <div class="service-card-content">
                    <h3>Home Additions</h3>
                    <p>Add the space you need without losing the character of your home. We create additions that feel like they belong from day one.</p>
                </div>
            </article>

            <article class="service-card service-card-remodels">
                <div class="service-card-content">
                    <h3>High-End Remodels</h3>
                    <p>Transform existing spaces with thoughtful design, quality materials, and detailed craftsmanship built to stand the test of time.</p>
                </div>
            </article>

            <article class="service-card service-card-decks">
                <div class="service-card-content">
                    <h3>Decks &amp; Patios</h3>
                    <p>Create an outdoor space made for morning coffee, summer gatherings, quiet evenings, and everything in between.</p>
                </div>
            </article>

            <article class="service-card service-card-landscaping">
                <div class="service-card-content">
                    <h3>Landscaping &amp; Clearing</h3>
                    <p>Prepare, improve, and shape your property with practical clearing and outdoor work that makes your land more usable and inviting.</p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="services-cta">
    <div class="site-shell">
        <p class="services-kicker">START A CONVERSATION</p>
        <h2>Have a project in mind?</h2>
        <p>We would be glad to learn about your goals and talk through the next steps.</p>
        <a class="home-button home-button-primary" asp-page="/Contact">
            Contact us <span aria-hidden="true">&rarr;</span>
        </a>
    </div>
</section>
